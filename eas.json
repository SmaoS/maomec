{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "free",
        "APP_PLATFORM": "android",
        "APP_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "free",
        "APP_PLATFORM": "android",
        "APP_ENV": "development"
      }
    },
    "android-free": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": {
        "APP_VARIANT": "free",
        "APP_PLATFORM": "android",
        "APP_ENV": "production"
      }
    },
    "android-pro": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": {
        "APP_VARIANT": "pro",
        "APP_PLATFORM": "android",
        "APP_ENV": "production"
      }
    },
    "ios-pro": {
      "autoIncrement": true,
      "distribution": "store",
      "env": {
        "APP_VARIANT": "pro",
        "APP_PLATFORM": "ios",
        "APP_ENV": "production"
      }
    },
    "android-free-apk": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "APP_VARIANT": "free",
        "APP_PLATFORM": "android",
        "APP_ENV": "development"
      }
    },
    "android-pro-apk": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "APP_VARIANT": "pro",
        "APP_PLATFORM": "android",
        "APP_ENV": "production"
      }
    }
  },
  "submit": {
    "android-free": {
      "android": { "track": "internal", "releaseStatus": "draft" }
    },
    "android-pro": {
      "android": { "track": "internal", "releaseStatus": "draft" }
    },
    "ios-pro": { "ios": {} }
  }
}
