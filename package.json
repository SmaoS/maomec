{
  "name": "maomec",
  "version": "1.0.1",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^57.0.25",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-google-mobile-ads": "15.8.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.4",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "build:apk:free": "powershell -ExecutionPolicy Bypass -File scripts/build-android-local.ps1 -Variant free -Artifact apk",
    "build:apk:pro": "powershell -ExecutionPolicy Bypass -File scripts/build-android-local.ps1 -Variant pro -Artifact apk",
    "build:aab:free": "powershell -ExecutionPolicy Bypass -File scripts/build-android-local.ps1 -Variant free -Artifact aab",
    "build:aab:pro": "powershell -ExecutionPolicy Bypass -File scripts/build-android-local.ps1 -Variant pro -Artifact aab",
    "build:signing:android:free": "npx eas-cli build --platform android --profile android-free-apk",
    "build:signing:android:pro": "npx eas-cli build --platform android --profile android-pro-apk",
    "build:store:ios:pro": "npx eas-cli build --platform ios --profile ios-pro"
  },
  "private": true
}
